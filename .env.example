# Copie este arquivo para .env (ou configure como variáveis de ambiente no Vercel)
# e preencha com as credenciais do seu projeto Supabase.
# Sem essas variáveis, o app roda em modo de demonstração com dados locais.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Usado apenas se/quando você rodar Prisma diretamente contra o Postgres do Supabase
DATABASE_URL=
